<!DOCTYPE html>

<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <link rel="stylesheet" href="/css/styles.css">

    <title>Mi Ecommerce</title>

</head>

<body>
    <%- include("../partials/headerHome.ejs") %>
        <main class="index">
            <%- include("../partials/categoryBar.ejs") %>
                <%- include("../partials/productHero.ejs") %>
                    <h2>Te puede interesar</h2>
                    <!--recibe el array de productos--->
                    <% for (let i=0; i < productosSugeridos.length; i++) { %>
                        <%- include("../partials/productCard.ejs", { producto: productosSugeridos[i] }) %>
                            <% } %>
                    <h2>Lo mas pedido</h2>
                    <!--recibe el array de productos--->
                    <% for (let i=0; i < productosMasPedidos.length; i++) { %>
                        <%- include("../partials/productCard.ejs", { producto: productosMasPedidos[i] }) %>
                                    <% } %>
                    <%- include("../partials/categoryBar.ejs") %>
        </main>
        <%- include("../partials/footer.ejs") %>
</body>



</html>