<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/styles.css">
    <title>Mi Ecommerce</title>
</head>

<body>

    <%- include("../partials/headerHome.ejs") %>

        <main class="product-pages">
            <nav class="breadcrumb">
                <a href="/">← Volver al listado</a>
                <span>&gt;</span>
                <span><%= producto.categoria %></span>
            </nav>
            <section class="product-details">
                <h1>
                    <%= producto.nombre %>
                </h1>
                <div class="product-gallery">
                    <div class="miniaturas">
                        <a href="#">
                            <img src="/imagenesProductCard/imagenesJagger/jagger3.png"
                                alt="<%=producto.nombre%>"
                        </a>
                        <a href="#">
                            <img src="/imagenesProductCard/imagenesJagger/jagger4.png" alt="<%=producto.nombre%>">
                        </a>
                        <a href="#">
                            <img src= "<%=producto.imagen%>"  alt="imagen de jagger principal">
                        </a>
                    </div>
                    <a href="#">
                        <img class="imagen-principal" src= "<%=producto.imagen%>"
                            alt="<%=producto.nombre%>"
                            
                    </a>

                </div>
                <article class="product-detail-info">
                    <p class="product-price">
                        <span class="product-points"><%=producto.precio%></span>
                        <span class="product-points-label">PUNTOS</span>
                    </p>
                    <p>
                        <%=producto.descripcion%>
                    </p>
                    <form action="/cart" method="post">
                        <!-- enviamos el id del producto -->
                        <input type="hidden" name="productId" value= "<%=producto.id%>">
                        <button class="boton" type="submit">
                            Agregar al carrito
                        </button>
                    </form>
                </article>

            </section>

            <h2 class="te-puede-interesar">
                Tambien te puede interesar
            </h2>
            <%- include("../partials/productCard.ejs") %>
                <%- include("../partials/categoryBar.ejs") %>
        </main>
        <%- include("../partials/footer.ejs") %>

</body>

</html>