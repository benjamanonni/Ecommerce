<main class="product-pages">
    <nav class="breadcrumb">
        <span></span>
    </nav>
    <% if (productos.length === 0) { %>
        <h1>No existe ese producto</h1>
    <% } else { %>
        <% for (let i = 0; i < productos.length; i++) { %>
            <% const producto = productos[i]; %>
            <section class="product-details">
                <h1><%= producto.nombre %></h1>

                <div class="product-gallery">
                    <div class="miniaturas">
                        <a href="#">
                            <img src="<%= producto.imagenTerciaria %>" alt="<%= producto.nombre %>">
                        </a>
                        <a href="#">
                            <img src="<%= producto.imagenSecundaria %>" alt="<%= producto.nombre %>">
                        </a>
                        <a href="#">
                            <img src="<%= producto.imagenPrimaria %>" alt="<%= producto.nombre %>">
                        </a>
                    </div>
                    <a href="#">
                        <img class="imagen-principal" src="<%= producto.imagenPrimaria %>" alt="<%= producto.nombre %>">
                    </a>
                </div>

                <article class="product-detail-info">
                    <p class="product-price">
                        <span class="product-points"><%= producto.precio %></span>
                        <span class="product-points-label">PUNTOS</span>
                    </p>
                    <p><%= producto.descripcion %></p>

                    <form action="/cart" method="post">
                        <!-- enviamos el id del producto -->
                        <input type="hidden" name="productId" value="<%= producto.id %>">
                        <% if (producto.stock <= 0) { %>
                            <button class="boton" type="button" disabled>Sin stock</button>
                        <% } else { %>
                            <button class="boton" type="submit">Agregar al carrito</button>
                        <% } %>
                    </form>
                </article>
            </section>
        <% } %>
    <% } %>
</main>