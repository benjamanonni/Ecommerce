<link rel="stylesheet" href="/css/styles.css">
<header class="header-home">
    <a class="header-logo" href="/">
        <!--separamos nombre en 2 partes porque son diferentes -->
        <span class="logo-mi">MiE</span><span class="logo-ecommerce">commerce</span>
    </a>

    <form action="/search" method= "GET" class="header-buscador">
        <label for="buscar producto" class="visually-hidden" >Buscar producto </label>
        <input id="buscador" type="text" placeholder="Buscar producto" name="query">
        <button type="submit">
            <img src="/imagenesHeaderHome/lupita.svg" alt="imagen de lupa ">
        </button>
    </form>

    <a href="/cart">
        <img class="header-carrito-icono" src="/imagenesHeaderHome/shopping-cart.svg" alt="Carrito">
        <span class="header-carrito-cantidad">
        <%= cantidadCarrito %>
    </span>
    </a>
    <div class="header-auth">
    <a href="/login">Iniciar sesión</a>
    <a href="/register">Registrarse</a>
</div>
</header>