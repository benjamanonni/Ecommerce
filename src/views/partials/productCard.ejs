
    <article class="product-card">
        <a href="/products/<%= producto.id %>">
            <img src="<%=producto.imagen%>" alt="<%=producto.nombre%>">
            <div class="product-info">
            <h3><%=producto.nombre%></h3>
            <p><%=producto.precio%></p>
        </div>
        </a>
    </article>